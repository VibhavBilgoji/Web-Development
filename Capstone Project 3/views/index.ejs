<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OnlyBlogs - Your Personal Blog Space</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="styles/styles.css" />
</head>
<body>
    <!-- Navigation Header -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="fas fa-blog me-2 brand-icon"></i>
                <span class="brand-text">OnlyBlogs</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/"><i class="fas fa-home me-1"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#posts"><i class="fas fa-newspaper me-1"></i> Posts</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about"><i class="fas fa-info-circle me-1"></i> About</a>
                    </li>
                </ul>
                <button class="btn btn-primary ms-lg-3" data-bs-toggle="modal" data-bs-target="#createPostModal">
                    <i class="fas fa-plus me-2"></i>New Post
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <!-- Decorative floating shapes -->
        <div class="hero-shape hero-shape-1"></div>
        <div class="hero-shape hero-shape-2"></div>
        <div class="hero-shape hero-shape-3"></div>
        <div class="hero-shape hero-shape-4"></div>

        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <!-- Feature badges -->
                    <div class="hero-badges mb-4">
                        <span class="hero-badge">
                            <i class="fas fa-bolt"></i> Fast & Easy
                        </span>
                        <span class="hero-badge">
                            <i class="fas fa-palette"></i> Beautiful Design
                        </span>
                        <span class="hero-badge">
                            <i class="fas fa-shield-alt"></i> Secure
                        </span>
                    </div>

                    <h1 class="hero-title">Welcome to OnlyBlogs</h1>
                    <p class="hero-subtitle">Share your thoughts, stories, and ideas with the world. Create beautiful blog posts in seconds.</p>

                    <div class="hero-cta-group">
                        <button class="btn btn-hero btn-lg" data-bs-toggle="modal" data-bs-target="#createPostModal">
                            <i class="fas fa-pen-fancy me-2"></i>Start Writing
                        </button>
                        <a href="#posts" class="btn btn-outline-hero btn-lg ms-3">
                            <i class="fas fa-compass me-2"></i>Explore Posts
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 text-center position-relative">
                    <!-- Decorative illustration elements -->
                    <div class="hero-illustration-wrapper">
                        <div class="hero-illustration">
                            <i class="fas fa-book-reader"></i>
                        </div>
                        <!-- Additional decorative icons -->
                        <div class="floating-icon floating-icon-1">
                            <i class="fas fa-pen"></i>
                        </div>
                        <div class="floating-icon floating-icon-2">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="floating-icon floating-icon-3">
                            <i class="fas fa-comment"></i>
                        </div>
                        <div class="floating-icon floating-icon-4">
                            <i class="fas fa-share-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="stat-card">
                        <i class="fas fa-newspaper stat-icon"></i>
                        <h3 class="stat-number"><%= stats.totalPosts %></h3>
                        <p class="stat-label">Total Posts</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="stat-card">
                        <i class="fas fa-clock stat-icon"></i>
                        <h3 class="stat-number"><%= stats.recentPosts %></h3>
                        <p class="stat-label">This Week</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="fas fa-tags stat-icon"></i>
                        <h3 class="stat-number"><%= stats.totalCategories %></h3>
                        <p class="stat-label">Categories</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Blog Posts Section -->
    <section class="posts-section" id="posts">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Latest Posts</h2>
                <p class="section-subtitle">Explore all your amazing blog posts</p>
            </div>

            <!-- Filter and Sort Options -->
            <div class="filter-bar mb-4">
                <form method="GET" action="/">
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                                <input type="text" class="form-control" name="search"
                                       placeholder="Search posts..." value="<%= filters.search %>">
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="d-flex gap-2">
                                <select class="form-select" name="category" onchange="this.form.submit()">
                                    <option value="all" <%= filters.category === 'all' ? 'selected' : '' %>>All Categories</option>
                                    <option value="technology" <%= filters.category === 'technology' ? 'selected' : '' %>>Technology</option>
                                    <option value="lifestyle" <%= filters.category === 'lifestyle' ? 'selected' : '' %>>Lifestyle</option>
                                    <option value="travel" <%= filters.category === 'travel' ? 'selected' : '' %>>Travel</option>
                                    <option value="food" <%= filters.category === 'food' ? 'selected' : '' %>>Food</option>
                                    <option value="other" <%= filters.category === 'other' ? 'selected' : '' %>>Other</option>
                                </select>
                                <select class="form-select" name="sort" onchange="this.form.submit()">
                                    <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                                    <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                                    <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title (A-Z)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Search
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Posts Grid -->
            <div class="row" id="postsContainer">
                <% if (posts.length === 0) { %>
                    <!-- Empty State -->
                    <div class="col-12">
                        <div class="empty-state">
                            <i class="fas fa-file-alt empty-icon"></i>
                            <h3>No Posts Yet</h3>
                            <p>Start creating your first blog post and share your thoughts with the world!</p>
                            <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#createPostModal">
                                <i class="fas fa-plus me-2"></i>Create Your First Post
                            </button>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Loop through posts -->
                    <% posts.forEach((post, index) => { %>
                        <div class="col-lg-4 col-md-6 mb-4" style="animation-delay: <%= index * 0.1 %>s;">
                            <article class="blog-card">
                                <div class="blog-card-header">
                                    <span class="badge blog-badge badge-<%= post.category %>">
                                        <%= post.category %>
                                    </span>
                                    <div class="dropdown">
                                        <button class="btn btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="/posts/<%= post.id %>/edit">
                                                    <i class="fas fa-edit me-2"></i>Edit
                                                </a>
                                            </li>
                                            <li>
                                                <form method="POST" action="/posts/<%= post.id %>/delete" style="display: inline;">
                                                    <button type="submit" class="dropdown-item text-danger"
                                                            onclick="return confirm('Are you sure you want to delete this post?')">
                                                        <i class="fas fa-trash me-2"></i>Delete
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="blog-card-body">
                                    <h3 class="blog-card-title"><%= post.title %></h3>
                                    <p class="blog-card-content"><%= truncateText(post.content, 120) %></p>
                                    <div class="blog-card-meta">
                                        <span><i class="far fa-calendar me-1"></i><%= formatDate(post.createdAt) %></span>
                                        <span><i class="far fa-clock me-1"></i><%= formatTime(post.createdAt) %></span>
                                    </div>
                                </div>
                                <div class="blog-card-footer">
                                    <a href="/posts/<%= post.id %>" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i>Read More
                                    </a>
                                </div>
                            </article>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about-section" id="about">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="section-title">About OnlyBlogs</h2>
                    <p class="about-text">OnlyBlogs is your personal space to express yourself through writing. Whether you're sharing your latest adventure
, a new recipe, tech insights, or daily musings, this platform makes it easy to create, manage, and showcase your content beautifully.</p>
                    <div class="features-grid">
                        <div class="feature-item">
                            <i class="fas fa-pen feature-icon"></i>
                            <h4>Easy Writing</h4>
                            <p>Simple and intuitive interface for creating posts</p>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-palette feature-icon"></i>
                            <h4>Beautiful Design</h4>
                            <p>Modern, responsive layout that looks great everywhere</p>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-bolt feature-icon"></i>
                            <h4>Quick & Fast</h4>
                            <p>Lightning-fast performance for the best experience</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5 class="footer-title">
                        <i class="fas fa-blog me-2"></i>OnlyBlogs
                    </h5>
                    <p class="footer-text">Your personal blogging platform to share stories, ideas, and experiences with the world.</p>
                </div>
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5 class="footer-title">Quick Links</h5>
                    <ul class="footer-links">
                        <li><a href="/"><i class="fas fa-chevron-right me-2"></i>Home</a></li>
                        <li><a href="#posts"><i class="fas fa-chevron-right me-2"></i>Posts</a></li>
                        <li><a href="#about"><i class="fas fa-chevron-right me-2"></i>About</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5 class="footer-title">Connect</h5>
                    <div class="social-links">
                        <a href="https://www.instagram.com/vibhav_the_great/" class="social-link" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://x.com/BilgojiVibhav" class="social-link" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="https://www.facebook.com/vibhav.bilgoji" class="social-link" aria-label="Facebook">
                            <i class="fab fa-facebook"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/vibhav-bilgoji-5997b518a/" class="social-link" aria-label="LinkedIn">
                            <i class="fab fa-linkedin"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="footer-divider">
            <div class="row">
                <div class="col-12 text-center">
                    <p class="copyright">© 2025 Vibhav Bilgoji. All rights reserved. Made with <i class="fas fa-heart text-danger"></i></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Create/Edit Post Modal -->
    <div class="modal fade" id="createPostModal" tabindex="-1" aria-labelledby="createPostModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createPostModalLabel">
                        <i class="fas fa-pen me-2"></i><span id="modalTitle">Create New Post</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="POST" action="/posts">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="postTitle" class="form-label">Post Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg" name="title"
                                   placeholder="Enter an engaging title..." required>
                        </div>
                        <div class="mb-3">
                            <label for="postCategory" class="form-label">Category <span class="text-danger">*</span></label>
                            <select class="form-select" name="category" required>
                                <option value="">Choose a category...</option>
                                <option value="technology">Technology</option>
                                <option value="lifestyle">Lifestyle</option>
                                <option value="travel">Travel</option>
                                <option value="food">Food</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="postContent" class="form-label">Content <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="content" rows="8"
                                      placeholder="Write your amazing content here..." required></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="postAuthor" class="form-label">Author Name</label>
                            <input type="text" class="form-control" name="author"
                                   placeholder="Your name (optional)">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Publish Post
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
