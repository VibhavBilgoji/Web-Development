<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - OnlyBlogs</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/styles/styles.css" />
</head>
<body>
    <!-- Navigation Header -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="fas fa-blog me-2 brand-icon"></i>
                <span class="brand-text">OnlyBlogs</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home me-1"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#posts"><i class="fas fa-newspaper me-1"></i> Posts</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#about"><i class="fas fa-info-circle me-1"></i> About</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Post Content Section -->
    <section class="py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <!-- Back Button -->
                    <div class="mb-4">
                        <a href="/" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to All Posts
                        </a>
                    </div>

                    <!-- Post Card -->
                    <article class="card shadow-sm">
                        <div class="card-header bg-white py-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge fs-6 px-3 py-2" style="background: <%= getCategoryColor(post.category) %>;">
                                    <%= post.category %>
                                </span>
                                <div class="dropdown">
                                    <button class="btn btn-link text-secondary" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" href="/posts/<%= post.id %>/edit">
                                                <i class="fas fa-edit me-2"></i>Edit Post
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="POST" action="/posts/<%= post.id %>/delete" style="display: inline;">
                                                <button type="submit" class="dropdown-item text-danger"
                                                        onclick="return confirm('Are you sure you want to delete this post?')">
                                                    <i class="fas fa-trash me-2"></i>Delete Post
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <h1 class="display-5 fw-bold mb-3"><%= post.title %></h1>
                            <div class="text-muted">
                                <i class="far fa-user me-2"></i><%= post.author %>
                                <span class="mx-2">•</span>
                                <i class="far fa-calendar me-2"></i><%= formatDate(post.createdAt) %>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="post-content" style="font-size: 1.1rem; line-height: 1.8; white-space: pre-wrap;">
<%= post.content %>
                            </div>
                        </div>
                        <div class="card-footer bg-white py-4">
                            <div class="d-flex gap-2">
                                <a href="/posts/<%= post.id %>/edit" class="btn btn-primary">
                                    <i class="fas fa-edit me-2"></i>Edit Post
                                </a>
                                <form method="POST" action="/posts/<%= post.id %>/delete" style="display: inline;">
                                    <button type="submit" class="btn btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this post?')">
                                        <i class="fas fa-trash me-2"></i>Delete Post
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>

                    <!-- Meta Information -->
                    <div class="mt-4 p-4 bg-light rounded">
                        <h5 class="mb-3">Post Information</h5>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <strong>Created:</strong> <%= formatDate(post.createdAt) %>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Last Updated:</strong> <%= formatDate(post.updatedAt) %>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Category:</strong> <%= post.category %>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Author:</strong> <%= post.author %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer mt-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5 class="footer-title">
                        <i class="fas fa-blog me-2"></i>OnlyBlogs
                    </h5>
                    <p class="footer-text">Your personal blogging platform to share stories, ideas, and experiences with the world.</p>
                </div>
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5 class="footer-title">Quick Links</h5>
                    <ul class="footer-links">
                        <li><a href="/"><i class="fas fa-chevron-right me-2"></i>Home</a></li>
                        <li><a href="/#posts"><i class="fas fa-chevron-right me-2"></i>Posts</a></li>
                        <li><a href="/#about"><i class="fas fa-chevron-right me-2"></i>About</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5 class="footer-title">Connect</h5>
                    <div class="social-links">
                        <a href="https://www.instagram.com/vibhav_the_great/" class="social-link" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://x.com/BilgojiVibhav" class="social-link" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="https://www.facebook.com/vibhav.bilgoji" class="social-link" aria-label="Facebook">
                            <i class="fab fa-facebook"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/vibhav-bilgoji-5997b518a/" class="social-link" aria-label="LinkedIn">
                            <i class="fab fa-linkedin"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="footer-divider">
            <div class="row">
                <div class="col-12 text-center">
                    <p class="copyright">© 2025 Vibhav Bilgoji. All rights reserved. Made with <i class="fas fa-heart text-danger"></i></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
